{
  "name": "daily-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first daily digest of global financial and AI news.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:news": "tsx scripts/fetch-news.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.8",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

---
import { TOPIC_LABELS } from '../lib/labels';
import { loadSummary } from '../lib/summary-data';
import type { Story, Topic } from '../lib/types';

/**
 * The AI-written brief for each topic, with links to the stories each bullet is based on.
 * Renders nothing when there is no summary; a topic with no bullets is left out.
 */
interface Props {
  stories: Story[];
}

const { stories } = Astro.props;
const summary = loadSummary();
const byId = new Map(stories.map((s) => [s.id, s]));
const topics = (['finance', 'ai'] as Topic[])
  .map((topic) => ({
    topic,
    bullets: (summary?.[topic] ?? [])
      .map((b) => ({ text: b.text, why: b.why, impact: b.impact, sources: b.storyIds.map((id) => byId.get(id)).filter((s): s is Story => s !== undefined) }))
      .filter((b) => b.sources.length > 0),
  }))
  .filter((t) => t.bullets.length > 0);
---

{
  summary && topics.length > 0 && (
    <section class="brief" aria-labelledby="brief-title" data-brief>
      <details open>
        <summary>
          <span class="spark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2l2.2 6.3L20.5 10l-6.3 2.2L12 18.5l-2.2-6.3L3.5 10l6.3-1.7z" fill="currentColor"></path></svg>
          </span>
          <h2 id="brief-title">Today in brief</h2>
          <span class="badge">AI-generated summary</span>
        </summary>
        {topics.map(({ topic, bullets }) => (
          <div class="topic" data-topic={topic}>
            <h3 data-kind={topic}>{TOPIC_LABELS[topic]}</h3>
            <ul>
              {bullets.map((b) => (
                <li>
                  <p>{b.text}</p>
                  {(b.why || b.impact) && (
                    <dl class="insight">
                      {b.why && (
                        <div>
                          <dt>Why it matters</dt>
                          <dd>{b.why}</dd>
                        </div>
                      )}
                      {b.impact && (
                        <div>
                          <dt>Market impact</dt>
                          <dd>{b.impact}</dd>
                        </div>
                      )}
                    </dl>
                  )}
                  <p class="sources">
                    <span class="visually-hidden">Sources:</span>
                    {b.sources.map((s) => (
                      <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.title}>
                        <span>{s.source}</span>
                      </a>
                    ))}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="note">
          Written by Claude from the headlines on this page. "Why it matters" and "Market impact" are Claude's analysis, not
          reporting or investment advice. It can make mistakes, so check the linked stories.
        </p>
      </details>
    </section>
  )
}

<style>
  .brief {
    position: relative;
    margin-bottom: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 16px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin-left: 4px;
    border-right: 2px solid var(--text-muted);
    border-bottom: 2px solid var(--text-muted);
    transform: rotate(45deg) translateY(-2px);
  }

  details[open] summary::after {
    transform: rotate(-135deg) translateY(-2px);
  }

  .spark {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    color: #000;
    background: var(--accent);
  }

  h2 {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge {
    font-family: var(--mono);
    margin-left: auto;
    padding: 2px 8px;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .topic {
    padding: 0 16px;
  }

  .topic + .topic {
    margin-top: 6px;
  }

  .topic[hidden] {
    display: none;
  }

  h3 {
    font-family: var(--mono);
    display: inline-block;
    margin: 4px 0 0;
    padding: 2px 9px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  h3[data-kind='finance'] {
    color: var(--finance);
    background: var(--finance-soft);
  }

  h3[data-kind='ai'] {
    color: var(--ai);
    background: var(--ai-soft);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 16px;
  }

  li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 16px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  [data-topic='finance'] li::before {
    background: var(--finance);
  }

  [data-topic='ai'] li::before {
    background: var(--ai);
  }

  li p {
    margin: 8px 0 0;
    line-height: 1.5;
  }

  .insight {
    display: grid;
    gap: 6px;
    margin: 8px 0 0;
    padding: 10px 12px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .insight dt {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .insight dd {
    margin: 1px 0 0;
  }

  .sources {
    display: flex;
    flex-wrap: wrap;
    column-gap: 6px;
    /* The links keep a 44 px tap height; the negative margin stops that adding visible space. */
    margin: -4px 0 -8px !important;
  }

  /* 44 px tall tap area around a smaller pill. */
  .sources a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .sources span {
    font-family: var(--mono);
    padding: 3px 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: var(--radius-sm);
  }

  .note {
    margin: 6px 16px 0;
    padding: 10px 0 14px;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
  }
</style>

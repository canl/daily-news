---
interface Props {
  active: 'today' | 'markets';
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="tabbar" aria-label="Sections">
  <a href={`${base}/`} aria-current={active === 'today' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="2"></rect><path d="M8 9h8M8 13h8M8 17h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
    <span>Today</span>
  </a>
  <a href={`${base}/markets/`} aria-current={active === 'markets' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15 7h6v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    <span>Markets</span>
  </a>
</nav>

<style>
  .tabbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border-top: 1px solid var(--border);
    padding-bottom: env(safe-area-inset-bottom);
  }

  a {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-height: 56px;
    padding: 6px 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
  }

  a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
  }

  svg {
    padding: 3px 16px;
    box-sizing: content-box;
    border-radius: 999px;
  }

  a[aria-current='page'] svg {
    background: var(--accent-soft);
  }
</style>

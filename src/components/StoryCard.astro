---
import { REGION_LABELS, TOPIC_LABELS } from '../lib/labels';
import { relativeTime } from '../lib/time';
import type { Story } from '../lib/types';

interface Props {
  story: Story;
  now: Date;
}

const { story, now } = Astro.props;
const more = story.alsoReportedBy.length;
---

<article
  class="card"
  data-topic={story.topic}
  data-region={story.region}
  data-search={`${story.title} ${story.source} ${story.alsoReportedBy.join(' ')}`.toLowerCase()}
>
  <h2 class="card-title">
    <a href={story.url} target="_blank" rel="noopener noreferrer">{story.title}</a>
  </h2>
  {story.snippet && <p class="card-snippet">{story.snippet}</p>}
  <p class="card-meta">
    <span class="source">{story.source}</span>
    {more > 0 && <span class="more">+{more} more {more === 1 ? 'source' : 'sources'}</span>}
    <span class="tag" data-kind={story.topic}>{TOPIC_LABELS[story.topic]}</span>
    <span class="tag">{REGION_LABELS[story.region]}</span>
    <time datetime={story.publishedAt} data-relative>{relativeTime(story.publishedAt, now)}</time>
  </p>
</article>

<style>
  .card {
    position: relative;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .card-title {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.35;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title a {
    color: var(--text);
    text-decoration: none;
  }

  .card-title a:focus {
    outline: none;
  }

  /* The whole card is the tap target for the headline link. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-snippet {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 10px 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .source {
    font-weight: 600;
    color: var(--text);
  }

  .tag {
    padding: 1px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
  }

  .tag[data-kind='ai'] {
    color: var(--accent);
    border-color: currentColor;
  }

  time {
    margin-left: auto;
  }
</style>

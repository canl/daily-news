---
import { direction, formatPrice } from '../lib/format';
import { loadMarkets } from '../lib/markets-data';

/** The first four stock indices, linking to the Markets page. Renders nothing when there is no market data. */
const markets = loadMarkets();
const indices = (markets?.instruments ?? []).filter((m) => m.group === 'indices').slice(0, 4);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  indices.length > 0 && (
    <a class="strip" href={`${base}/markets/`} aria-label="Market moves, open the Markets page">
      {indices.map((m) => {
        const dir = direction(m);
        return (
          <span class="tile" data-dir={dir}>
            <span class="name">{m.name}</span>
            <span class="price">{formatPrice(m)}</span>
            <span class="pct">
              <span aria-hidden="true">{dir === 'up' ? '▲' : dir === 'down' ? '▼' : '■'}</span>
              {` ${m.changePct > 0 ? '+' : m.changePct < 0 ? '−' : ''}${Math.abs(m.changePct).toFixed(2)}%`}
            </span>
          </span>
        );
      })}
    </a>
  )
}

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(132px, 1fr));
    gap: 10px;
    margin: 0 calc(-1 * var(--gutter)) 18px;
    padding: 2px var(--gutter) 4px;
    overflow-x: auto;
    scrollbar-width: none;
    color: inherit;
    text-decoration: none;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .tile {
    display: grid;
    gap: 4px;
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    font-variant-numeric: tabular-nums;
  }

  .name {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .price {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .pct {
    justify-self: start;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  [data-dir='up'] .pct {
    color: var(--up);
    background: var(--up-soft);
  }

  [data-dir='down'] .pct {
    color: var(--down);
    background: var(--down-soft);
  }

  [data-dir='flat'] .pct {
    color: var(--text-muted);
    background: var(--surface-2);
  }

  @media (min-width: 720px) {
    .strip {
      margin-inline: 0;
      padding-inline: 0;
    }
  }
</style>

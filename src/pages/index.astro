---
import Brief from '../components/Brief.astro';
import MarketStrip from '../components/MarketStrip.astro';
import StoryCard from '../components/StoryCard.astro';
import Base from '../layouts/Base.astro';
import { REGION_LABELS, TOPIC_LABELS } from '../lib/labels';
import { loadNews } from '../lib/news-data';
import { relativeTime } from '../lib/time';
import type { Region, Topic } from '../lib/types';

const news = loadNews();
const stories = news?.stories ?? [];
const generatedAt = news?.generatedAt;
const now = generatedAt ? new Date(generatedAt) : new Date();

// For example "Sat 10 Oct", from the time the data was fetched.
const dateLabel = new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' }).format(now);
const topics = Object.entries(TOPIC_LABELS) as [Topic, string][];
const regions = Object.entries(REGION_LABELS) as [Region, string][];
---

<Base title="Daily News: finance and AI headlines" active="today">
  <header class="page-header">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 16l5-5 4 4 7-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
      <div class="brand-text">
        <h1>Daily News</h1>
        {
          generatedAt && (
            <p class="brand-sub updated">
              {dateLabel} · Updated <time datetime={generatedAt} data-relative>{relativeTime(generatedAt, now)}</time>
            </p>
          )
        }
      </div>
      <button class="icon-button" type="button" data-search-toggle aria-expanded="false" aria-controls="search-row" aria-label="Search headlines">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <div id="search-row" class="search-row" data-search-row hidden>
      <label class="visually-hidden" for="search">Search headlines</label>
      <input id="search" type="search" placeholder="Search headlines" autocomplete="off" enterkeyhint="search" />
    </div>
    <div class="segmented" role="group" aria-label="Topic">
      <button type="button" class="chip" data-filter="topic" value="all" aria-pressed="true">All</button>
      {
        topics.map(([value, label]) => (
          <button type="button" class="chip" data-filter="topic" value={value} aria-pressed="false">
            <span class="dot" data-kind={value} aria-hidden="true"></span>
            {label}
          </button>
        ))
      }
    </div>
    <div class="regions" role="group" aria-label="Region">
      <button type="button" class="chip" data-filter="region" value="all" aria-pressed="true">All regions</button>
      {regions.map(([value, label]) => <button type="button" class="chip" data-filter="region" value={value} aria-pressed="false">{label}</button>)}
    </div>
  </header>

  <main>
    <MarketStrip />
    <Brief stories={stories} />
    <p class="visually-hidden" role="status" aria-live="polite" data-status></p>
    {
      stories.length === 0 ? (
        <p class="empty">No stories yet. The next hourly update will fill this page.</p>
      ) : (
        <h2 class="section-label">Latest stories</h2>
        <div class="stories" data-story-list aria-busy="true">
          {stories.map((story) => <StoryCard story={story} now={now} />)}
        </div>
      )
    }
    <p class="empty" data-empty hidden>No stories match these filters.</p>
    <footer class="foot">
      Headlines and snippets from each publisher's public feed. Tap a story to read it on the publisher's site.
    </footer>
  </main>
</Base>

<script>
  import '../scripts/today';
</script>

<style>
  .icon-button {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    margin: 0 -8px 0 auto;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .icon-button[aria-expanded='true'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .search-row {
    max-width: 720px;
    margin: 8px auto 0;
  }

  .search-row input {
    width: 100%;
    min-height: 44px;
    padding: 8px 16px;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow);
  }

  .search-row input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Topic: one segmented control. */
  .segmented {
    display: flex;
    max-width: 720px;
    margin: 10px auto 0;
    padding: 3px;
    background: var(--surface-2);
    border-radius: 14px;
  }

  .segmented .chip {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 10px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    border-radius: 11px;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .segmented .chip[aria-pressed='true'] {
    color: var(--text);
    background: var(--raised);
    box-shadow: var(--shadow);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot[data-kind='finance'] {
    background: var(--finance);
  }

  .dot[data-kind='ai'] {
    background: var(--ai);
  }

  /* Region: a light, scrollable row; the visible pill is smaller than its 44 px tap area. */
  .regions {
    display: flex;
    gap: 2px;
    max-width: 720px;
    margin: 2px auto 0;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: calc(var(--gutter) - 10px);
  }

  .regions::-webkit-scrollbar {
    display: none;
  }

  .regions .chip {
    position: relative;
    isolation: isolate;
    flex: none;
    min-height: 44px;
    padding: 0 12px;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .regions .chip::before {
    content: '';
    position: absolute;
    inset: 7px 0;
    z-index: -1;
    border-radius: 999px;
    transition: background-color 0.15s;
  }

  .regions .chip[aria-pressed='true'] {
    color: var(--accent);
    font-weight: 600;
  }

  .regions .chip[aria-pressed='true']::before {
    background: var(--accent-soft);
  }

  .stories {
    display: grid;
    gap: 12px;
  }

  .empty {
    padding: 32px 0;
    text-align: center;
    color: var(--text-muted);
  }

  .foot {
    margin: 24px 0 8px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (min-width: 720px) {
    .regions {
      margin-inline: auto;
      padding-inline: 0;
    }
  }
</style>

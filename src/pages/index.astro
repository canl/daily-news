---
import Brief from '../components/Brief.astro';
import MarketStrip from '../components/MarketStrip.astro';
import StoryCard from '../components/StoryCard.astro';
import Base from '../layouts/Base.astro';
import { REGION_LABELS, TOPIC_LABELS } from '../lib/labels';
import { loadNews } from '../lib/news-data';
import { relativeTime } from '../lib/time';
import type { Region, Topic } from '../lib/types';

const news = loadNews();
const stories = news?.stories ?? [];
const generatedAt = news?.generatedAt;
const now = generatedAt ? new Date(generatedAt) : new Date();

const topics = Object.entries(TOPIC_LABELS) as [Topic, string][];
const regions = Object.entries(REGION_LABELS) as [Region, string][];
---

<Base title="Daily News: finance and AI headlines" active="today">
  <header class="top">
    <div class="top-row">
      <h1>Daily News</h1>
      {
        generatedAt && (
          <p class="updated">
            Updated <time datetime={generatedAt} data-relative>{relativeTime(generatedAt, now)}</time>
          </p>
        )
      }
      <button class="icon-button" type="button" data-search-toggle aria-expanded="false" aria-controls="search-row" aria-label="Search headlines">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <div id="search-row" class="search-row" data-search-row hidden>
      <label class="visually-hidden" for="search">Search headlines</label>
      <input id="search" type="search" placeholder="Search headlines" autocomplete="off" enterkeyhint="search" />
    </div>
    <div class="chips" role="group" aria-label="Topic">
      <button type="button" class="chip" data-filter="topic" value="all" aria-pressed="true">All</button>
      {topics.map(([value, label]) => <button type="button" class="chip" data-filter="topic" value={value} aria-pressed="false">{label}</button>)}
    </div>
    <div class="chips chips-small" role="group" aria-label="Region">
      <button type="button" class="chip" data-filter="region" value="all" aria-pressed="true">All regions</button>
      {regions.map(([value, label]) => <button type="button" class="chip" data-filter="region" value={value} aria-pressed="false">{label}</button>)}
    </div>
  </header>

  <main>
    <MarketStrip />
    <Brief stories={stories} />
    <p class="visually-hidden" role="status" aria-live="polite" data-status></p>
    {
      stories.length === 0 ? (
        <p class="empty">No stories yet. The next hourly update will fill this page.</p>
      ) : (
        <div class="stories" data-story-list aria-busy="true">
          {stories.map((story) => <StoryCard story={story} now={now} />)}
        </div>
      )
    }
    <p class="empty" data-empty hidden>No stories match these filters.</p>
    <footer class="foot">
      Headlines and snippets from each publisher's public feed. Tap a story to read it on the publisher's site.
    </footer>
  </main>
</Base>

<script>
  import '../scripts/today';
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: max(8px, env(safe-area-inset-top)) var(--gutter) 8px;
  }

  .top-row {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 720px;
    margin: 0 auto;
  }

  h1 {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .updated {
    margin: 0 0 0 auto;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .search-row {
    max-width: 720px;
    margin: 4px auto 0;
  }

  .search-row input {
    width: 100%;
    min-height: 44px;
    padding: 8px 14px;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .chips {
    display: flex;
    gap: 8px;
    max-width: 720px;
    margin: 8px auto 0;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex: none;
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
  }

  .chips-small .chip {
    font-size: 0.875rem;
    padding: 0 12px;
  }

  .stories {
    display: grid;
    gap: 12px;
  }

  .empty {
    padding: 32px 0;
    text-align: center;
    color: var(--text-muted);
  }

  .foot {
    margin: 24px 0 8px;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (min-width: 720px) {
    .chips {
      margin-inline: auto;
      padding-inline: 0;
    }
  }
</style>

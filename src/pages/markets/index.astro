---
import MarketRow from '../../components/MarketRow.astro';
import Base from '../../layouts/Base.astro';
import { formatAsOf } from '../../lib/format';
import { loadMarkets } from '../../lib/markets-data';
import { GROUP_LABELS } from '../../pipeline/instruments';
import type { InstrumentGroup } from '../../lib/types';

const markets = loadMarkets();
const instruments = markets?.instruments ?? [];
const groups = (Object.keys(GROUP_LABELS) as InstrumentGroup[])
  .map((group) => ({ group, label: GROUP_LABELS[group], rows: instruments.filter((m) => m.group === group) }))
  .filter((g) => g.rows.length > 0);
---

<Base title="Markets · Daily News" description="Delayed daily moves for key indices, AI stocks, currencies, commodities and crypto." active="markets">
  <header class="page-header">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 16l5-5 4 4 7-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
      <div class="brand-text">
        <h1>Markets</h1>
        {markets && <p class="brand-sub updated">Delayed · {formatAsOf(markets.generatedAt)}</p>}
      </div>
    </div>
  </header>
  <main>
    {
      groups.length === 0 ? (
        <p class="empty">No market data yet. The next hourly update will fill this page.</p>
      ) : (
        groups.map((g) => (
          <section aria-labelledby={`group-${g.group}`}>
            <h2 class="section-label" id={`group-${g.group}`}>{g.label}</h2>
            <div class="group">{g.rows.map((m) => <MarketRow instrument={m} />)}</div>
          </section>
        ))
      )
    }
    <p class="foot">
      Prices are delayed by 15 minutes or more and are for information only. Tap a row for its 30-day chart.
    </p>
  </main>
</Base>

<style>
  .page-header {
    padding-bottom: 10px;
  }

  section + section {
    margin-top: 22px;
  }

  .group {
    padding: 0 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .group > :global(.row:last-child) {
    border-bottom: 0;
  }

  .empty,
  .foot {
    color: var(--text-muted);
    text-align: center;
  }

  .empty {
    padding: 32px 0;
  }

  .foot {
    margin: 24px 0 8px;
    font-size: 0.8125rem;
  }
</style>
